//precision highp float;

uniform sampler2D videoTexture;
uniform float edgeTransparency;
uniform float globalOpacity; // Add this new uniform - value between 0.0 and 1.0

varying vec2 vUv;

// Function to calculate alpha based on distance from edges
float getAlpha(vec2 uv) {
    float distFromEdge = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
    return 1.0 - smoothstep(0.1, 0.0, distFromEdge / edgeTransparency);
}

void main() {
    vec4 color = texture2D(videoTexture, vUv);

     // For gamma correction from linear to gamma space (if your video is in linear space)
    //float gamma = 2.2;
    //color.rgb = pow(color.rgb, vec3(1.0/gamma));

    //color *= 0.75;
    float edgeAlpha = getAlpha(vUv);
    
    // Multiply by the global opacity factor
    float finalAlpha = edgeAlpha * globalOpacity;

       // Apply contrast adjustment
    // First convert to luminance-centered space (-0.5 to 0.5)
    vec3 contrastColor = (color.rgb - 0.5) * 1.5 + 0.5;
    
    // Clamp results to valid range
    contrastColor = clamp(contrastColor, 0.0, 1.0);
    
    // Ensure alpha doesn't go below 0.0 (technically unnecessary as multiplication won't go below 0)
    //finalAlpha = max(0.0, finalAlpha);
    
    gl_FragColor = vec4(color.rgb, finalAlpha);
}
