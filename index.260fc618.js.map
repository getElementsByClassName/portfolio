varying float vHeight;
//varying vec3 csm_vPosition;


float hash(vec2 p) {
    p = 50.0 * fract(p * 0.3183099 + vec2(0.71));
    return -1.0 + 2.0 * fract(p.x * p.y * (p.x + p.y));
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    
    return mix(mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}

void main() {
    precision mediump float;

            vUv = uv;
       
            vec3 transformedGrass = position * scale;
            transformedGrass = instanceRotationMatrix * transformedGrass;
            transformedGrass += offset;

            vHeight = clamp(position.y, 0.0, 1.0); 
            
            // Generate noise based on time
            float n = noise(vec2(time * 0.1, time * 0.05));

            // Scale the noise value to be in the range [0.0, 0.2]
            float varyingValue = n * 0.35;
  
            float noise = noise(offset.xz);
