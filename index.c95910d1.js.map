uniform sampler2D grassTexture;
varying vec2 vUv;
varying float vHeight;

// Move constants outside main() - they're compile-time constants
const float brightness = 1.25;
const vec3 topBladeColor = vec3(0.365, 0.588, 0.369);
const float mixFactor = 0.50;
const float uvScale = 0.5; // 1.0/100.0 precomputed

void main() {
    // Remove precision declaration from main() - should be at top of shader
    
    // Single texture lookup
    vec3 textureColor = texture2D(grassTexture, vUv * uvScale).rgb;
    
    // Combine operations to reduce instructions
    // Mix with top blade color and apply height-based darkening in one step
    float heightCubed = vHeight * vHeight * vHeight;
    textureColor = mix(textureColor, topBladeColor, mixFactor) * heightCubed * brightness;
    
    csm_DiffuseColor = vec4(textureColor, 1.0);
}

